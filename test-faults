#!/usr/bin/env bash
set -euo pipefail

root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
build_dir=""
if [ -f "$root/.last-build-dir" ]; then
    build_dir="$(cat "$root/.last-build-dir")"
fi
for candidate in "$build_dir" build-clang build-clang-22 build; do
    [ -n "$candidate" ] || continue
    if [ -x "$root/$candidate/test-faults" ]; then
        exec "$root/$candidate/test-faults" "$@"
    fi
done
echo "test-faults: native executable not built; configure and build this repository with CMake" >&2
exit 2
